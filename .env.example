# ==============================================================================
# FLOWLINE MONOREPO ROOT ENVIRONMENT VARIABLES
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection string (e.g. Supavisor / PgBouncer on port 6543)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true

# Direct connection string for schema migrations (port 5432)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. SUPABASE CREDENTIALS (Auth, Database & Storage - 2026 Standard)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=[YOUR-SUPABASE-PUBLISHABLE-KEY]
SUPABASE_SECRET_KEY=[YOUR-SUPABASE-SECRET-KEY]
SUPABASE_STORAGE_BUCKET=flowline-attachments

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT (In-Process Fastify Auth & Edge Validation)
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT tokens (min 32 characters)
JWT_SECRET=super-secret-jwt-key-replace-with-your-own-random-string-min-32-chars

# Token lifetime
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super-secret-refresh-key-replace-with-your-own-random-string

# ------------------------------------------------------------------------------
# 4. BACKEND API SERVICE (apps/api)
# ------------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. FRONTEND WEB APP (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=[YOUR-SUPABASE-PUBLISHABLE-KEY]

# ------------------------------------------------------------------------------
# 6. CACHE & RATE LIMITING (Upstash Redis Free Tier)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://[YOUR-UPSTASH-INSTANCE].upstash.io
UPSTASH_REDIS_REST_TOKEN=[YOUR-UPSTASH-REST-TOKEN]
